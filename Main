name: Generate GitHub Stats SVGs

# This workflow generates your GitHub stats and top-languages cards as static
# SVG files and commits them straight into this repo (into the /dist folder).
# Your README then displays those local files — so it NEVER depends on a
# third-party rendering server being online. This is the permanent fix for
# broken/flaky stats images.

on:
  schedule:
    - cron: "0 0 * * *"   # regenerates once a day
  workflow_dispatch:        # lets you trigger it manually from the Actions tab
  push:
    branches:
      - main

jobs:
  update-stats:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Generate stats images
        uses: jstrieb/github-stats@master
        with:
          username: bibekdhakal01
          exclude_repos:
          exclude_langs:
        env:
          ACCESS_TOKEN: ${{ secrets.ACCESS_TOKEN }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Commit generated files
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add dist/ || true
          git diff --staged --quiet || git commit -m "Update generated GitHub stats SVGs"
          git push
